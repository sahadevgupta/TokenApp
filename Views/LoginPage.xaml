<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TokenApp.Resources"
             xmlns:vm="clr-namespace:TokenApp.ViewModels"
             x:Class="TokenApp.Views.LoginPage"
             xmlns:controls="clr-namespace:TokenApp.Controls"
             BackgroundColor="WhiteSmoke"
             x:DataType="vm:LoginViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="16">
            <!-- Logo -->

            <Border WidthRequest="100"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    Margin="0,100,0,0"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50"/>
                </Border.StrokeShape>
                <Image Source="logo"/>
            </Border>


            <!-- Title -->
            <VerticalStackLayout HorizontalOptions="Center"
                                 Spacing="2">
                <Label Text="{x:Static res:AppResource.AppTitleLine1}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#C92A2A"
                       HorizontalOptions="Center"/>
                <Label Text="{x:Static res:AppResource.AppSubtitle}"
                       FontSize="14"
                       TextColor="#A64E4E"
                       HorizontalOptions="Center"/>
                <Label Text="{x:Static res:AppResource.AppNote}"
                       FontSize="12"
                       TextColor="#7C6A6A"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#FFF1EE"
                    Stroke="OrangeRed"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Label Text="{x:Static res:AppResource.AppNoteAlert}"
                       FontSize="13"
                       TextColor="#B84B4B"
                       HorizontalOptions="Center"/>
            </Border>


            <controls:ExtendedEntry Title="{x:Static res:AppResource.Username}"
                                    Text="{Binding Username}"
                                    PlaceholderText="{x:Static res:AppResource.UsernamePlaceholder}"/>

            <controls:ExtendedEntry Title="{x:Static res:AppResource.Password}"
                                    Text="{Binding Password}"
                                    PlaceholderText="{x:Static res:AppResource.UsernamePlaceholder}"
                                    IsPassword="True"/>

            <!-- Login button -->
            <Button Text="{x:Static res:AppResource.LoginButton}"
                    BackgroundColor="#B71C1C"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="52"
                    Command="{Binding LoginCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
