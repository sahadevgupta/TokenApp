<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:TokenApp.Controls"
             xmlns:converters="clr-namespace:TokenApp.Converters"
             xmlns:models="clr-namespace:TokenApp.Models"
             xmlns:vm="clr-namespace:TokenApp.ViewModels"
             x:Class="TokenApp.Views.TokenHistoryPage"
             x:DataType="vm:TokenHistoryViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.BackgroundColor="{StaticResource White}"
             Shell.ForegroundColor="{StaticResource BrandRed}"
             Shell.TitleColor="{StaticResource PrimaryColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TokenTypeNameConverter x:Key="TokenTypeNameConverter"/>
            <converters:TokenTypeColorConverter x:Key="TokenTypeColorConverter"/>
            <converters:TokenStatusNameConverter x:Key="TokenStatusNameConverter"/>
            <converters:TokenStatusColorConverter x:Key="TokenStatusColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand}"
                     AutomationId="LogoutButton"/>
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource BrandRed}"
                 BackgroundColor="{StaticResource PageBackground}">

        <CollectionView ItemsSource="{Binding TokenGroups}"
                        IsGrouped="True"
                        SelectionMode="None"
                        Margin="16,0"
                        BackgroundColor="Transparent">

            <!-- Everything above the list scrolls with it, so pull-to-refresh works from anywhere. -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12"
                        Padding="0,16,0,8">

                    <!-- Temple title -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="श्री काला गोरा भैरव धाम"
                               FontSize="20"
                               FontFamily="SpaceGroteskBold"
                               TextColor="{StaticResource BrandRedTitle}"/>
                        <Label Text="Bhairav Dham counter • Token history"
                               Style="{StaticResource TokenMetaStyle}"/>
                    </VerticalStackLayout>

                    <!-- Error banner (stale data stays visible underneath) -->
                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource BrandRedSoft}"
                            Stroke="OrangeRed"
                            StrokeShape="RoundRectangle 10"
                            Padding="12">
                        <Grid ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="#B84B4B"
                                   VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                    Text="Retry"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding RefreshCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Summary counts from the API -->
                    <Border IsVisible="{Binding HasSummary}"
                            Style="{StaticResource SummaryCardStyle}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0"
                                        Spacing="2">
                                    <Label Text="{Binding Summary.TotalTokens}"
                                            Style="{StaticResource SummaryValueStyle}"/>
                                    <Label Text="Total"
                                            Style="{StaticResource SummaryCaptionStyle}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                        Spacing="2">
                                    <Label Text="{Binding Summary.ApprovedTokens}"
                                           Style="{StaticResource SummaryValueStyle}"
                                           TextColor="{StaticResource StatusApprovedText}"/>
                                    <Label Text="Approved"
                                            Style="{StaticResource SummaryCaptionStyle}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                        Spacing="2">
                                    <Label Text="{Binding Summary.PendingTokens}"
                                           Style="{StaticResource SummaryValueStyle}"
                                           TextColor="{StaticResource StatusPendingText}"/>
                                    <Label Text="Pending"
                                            Style="{StaticResource SummaryCaptionStyle}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                    BackgroundColor="{StaticResource LightGray}"/>

                            <Grid ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="0,10"
                                        BackgroundColor="{StaticResource TokenYellowTint}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Summary.YellowTokens}"
                                               Style="{StaticResource SummaryValueStyle}"
                                               FontSize="22"
                                               TextColor="{StaticResource TokenYellowText}"/>
                                        <Label Text="Yellow"
                                                Style="{StaticResource SummaryCaptionStyle}"
                                               TextColor="{StaticResource TokenYellowText}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="0,10"
                                        BackgroundColor="{StaticResource TokenRedTint}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Summary.RedTokens}"
                                               Style="{StaticResource SummaryValueStyle}"
                                               FontSize="22"
                                               TextColor="{StaticResource TokenRedText}"/>
                                        <Label Text="Red"
                                                Style="{StaticResource SummaryCaptionStyle}"
                                               TextColor="{StaticResource TokenRedText}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="0,10"
                                        BackgroundColor="{StaticResource TokenEmergencyTint}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Summary.EmergencyTokens}"
                                               Style="{StaticResource SummaryValueStyle}"
                                               FontSize="22"
                                               TextColor="{StaticResource TokenEmergencyText}"/>
                                        <Label Text="Emergency"
                                                Style="{StaticResource SummaryCaptionStyle}"
                                               TextColor="{StaticResource TokenEmergencyText}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Today's token numbers -->
                    <Border IsVisible="{Binding HasSummary}"
                            Style="{StaticResource SummaryCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Today's token numbers"
                                    Style="{StaticResource SectionTitleStyle}"/>
                            <Grid ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0"
                                        Spacing="2">
                                    <Label Text="Yellow"
                                            Style="{StaticResource SummaryCaptionStyle}"
                                            TextColor="{StaticResource TokenYellowText}"/>
                                    <Label Style="{StaticResource TokenMetaStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.LastYellow, StringFormat='Last {0}'}"/>
                                    <Label Style="{StaticResource TokenPersonStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.NextYellow, StringFormat='Next {0}'}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                        Spacing="2">
                                    <Label Text="Red"
                                            Style="{StaticResource SummaryCaptionStyle}"
                                            TextColor="{StaticResource TokenRedText}"/>
                                    <Label Style="{StaticResource TokenMetaStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.LastRed, StringFormat='Last {0}'}"/>
                                    <Label Style="{StaticResource TokenPersonStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.NextRed, StringFormat='Next {0}'}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                        Spacing="2">
                                    <Label Text="Emergency"
                                            Style="{StaticResource SummaryCaptionStyle}"
                                            TextColor="{StaticResource TokenEmergencyText}"/>
                                    <Label Style="{StaticResource TokenMetaStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.LastEmergency, StringFormat='Last {0}'}"/>
                                    <Label Style="{StaticResource TokenPersonStyle}"
                                            HorizontalTextAlignment="Center"
                                           Text="{Binding Summary.TodayStats.NextEmergency, StringFormat='Next {0}'}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Search -->
                    <Border Style="{StaticResource SearchBoxStyle}"
                            HeightRequest="45">
                        <controls:BorderlessEntry Style="{StaticResource SearchEntryStyle}"
                                                  Placeholder="Search token #, name, mobile, city or date"
                                                  Text="{Binding SearchQuery}"
                                                  ReturnType="Search"
                                                  ClearButtonVisibility="WhileEditing"
                                                  SemanticProperties.Description="Search tokens"
                                                  VerticalOptions="Center"/>
                    </Border>

                    <!-- Type filter -->
                    <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8"
                                BindableLayout.ItemsSource="{Binding FilterOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TokenFilterOption">
                                    <Button Text="{Binding Label}"
                                            Style="{StaticResource FilterChipStyle}"
                                            Command="{Binding SelectCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{StaticResource BrandRed}"/>
                                                <Setter Property="BorderColor"
                                                        Value="{StaticResource BrandRed}"/>
                                                <Setter Property="TextColor"
                                                        Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Label Text="{Binding ResultText}"
                           IsVisible="{Binding HasSummary}"
                           Style="{StaticResource TokenMetaStyle}"/>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Date section header -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:TokenGroup">
                    <Grid ColumnDefinitions="*,Auto"
                            Padding="2,10,2,6"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Label Text="{Binding Title}"
                                Style="{StaticResource SectionTitleStyle}"
                                VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                                Text="{Binding CountText}"
                                Style="{StaticResource TokenMetaStyle}"
                                VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Token card -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TokenDTO">
                    <Border Style="{StaticResource TokenCardStyle}">
                        <Grid ColumnDefinitions="6,64,*">
                            <!-- Type accent bar -->
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{Binding Type, Converter={StaticResource TokenTypeColorConverter}, ConverterParameter='Accent'}"/>

                            <Label Grid.Column="1"
                                   Text="{Binding TokenNumber, StringFormat='#{0}'}"
                                   Style="{StaticResource TokenNumberStyle}"
                                   TextColor="{Binding Type, Converter={StaticResource TokenTypeColorConverter}, ConverterParameter='Text'}"
                                   VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="2"
                                    Spacing="4"
                                    Padding="0,12,12,12">
                                <Grid ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            HorizontalOptions="Start"
                                            BackgroundColor="{Binding Type, Converter={StaticResource TokenTypeColorConverter}, ConverterParameter='Tint'}">
                                        <Label Text="{Binding Type, Converter={StaticResource TokenTypeNameConverter}}"
                                               Style="{StaticResource StatusBadgeLabelStyle}"
                                               TextColor="{Binding Type, Converter={StaticResource TokenTypeColorConverter}, ConverterParameter='Text'}"/>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource StatusBadgeStyle}"
                                            BackgroundColor="{Binding Status, Converter={StaticResource TokenStatusColorConverter}}">
                                        <Label Text="{Binding Status, Converter={StaticResource TokenStatusNameConverter}}"
                                               Style="{StaticResource StatusBadgeLabelStyle}"
                                               TextColor="{Binding Status, Converter={StaticResource TokenStatusColorConverter}, ConverterParameter='Text'}"/>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Spacing="1"
                                        IsVisible="{Binding HasApplicant}">
                                    <Label Text="{Binding Applicant.Name}"
                                            Style="{StaticResource TokenPersonStyle}"/>
                                    <Label Text="{Binding Applicant.Details}"
                                            Style="{StaticResource TokenMetaStyle}"/>
                                </VerticalStackLayout>

                                <Label Text="{Binding CreatedAtText}"
                                        Style="{StaticResource TokenMetaStyle}"
                                        FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,32"
                        Spacing="8"
                        HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource BrandRed}"/>
                    <Label Text="{Binding EmptyMessage}"
                           IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
                           Style="{StaticResource TokenMetaStyle}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <ContentView HeightRequest="24"/>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
