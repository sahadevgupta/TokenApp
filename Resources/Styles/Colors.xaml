<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush"
                     Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush"
                     Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush"
                     Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush"
                     Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush"
                     Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush"
                     Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush"
                     Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush"
                     Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush"
                     Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush"
                     Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush"
                     Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush"
                     Color="{StaticResource Gray950}"/>

    <Color x:Key="LightGray">#E0E0E0</Color>
    <Color x:Key="BorderColor">#D0D0D0</Color>
    <Color x:Key="PrimaryColor">#0E1826</Color>


    <!-- Light palette (matches the Login page) -->
    <Color x:Key="PageBackground">#F5F5F5</Color>
    <Color x:Key="BrandRed">#B71C1C</Color>
    <Color x:Key="BrandRedTitle">#C92A2A</Color>
    <Color x:Key="BrandRedSoft">#FFF1EE</Color>
    <Color x:Key="TextSecondary">#7C6A6A</Color>

    <!-- Token type: Accent = bar/number, Tint = pill/tile background, Text = text on tint -->
    <Color x:Key="TokenYellowAccent">#E0A800</Color>
    <Color x:Key="TokenYellowTint">#FFF6D6</Color>
    <Color x:Key="TokenYellowText">#7A5A00</Color>
    <Color x:Key="TokenRedAccent">#DC143C</Color>
    <Color x:Key="TokenRedTint">#FDECEF</Color>
    <Color x:Key="TokenRedText">#A50E2D</Color>
    <Color x:Key="TokenEmergencyAccent">#7B68EE</Color>
    <Color x:Key="TokenEmergencyTint">#EFECFD</Color>
    <Color x:Key="TokenEmergencyText">#4B3FA0</Color>
    <Color x:Key="TokenOtherAccent">#919191</Color>
    <Color x:Key="TokenOtherTint">#EEEEEE</Color>
    <Color x:Key="TokenOtherText">#404040</Color>

    <!-- Token status badge -->
    <Color x:Key="StatusApprovedTint">#E3F5EA</Color>
    <Color x:Key="StatusApprovedText">#17703A</Color>
    <Color x:Key="StatusPendingTint">#FFF0CC</Color>
    <Color x:Key="StatusPendingText">#8A5A00</Color>

    <!-- Token Type Colors -->
    <Color x:Key="TokenYellow">#FFD700</Color>
    <Color x:Key="TokenYellowLight">#FFF8DC</Color>
    <Color x:Key="TokenYellowDark">#DAA520</Color>

    <Color x:Key="TokenRed">#DC143C</Color>
    <Color x:Key="TokenRedLight">#FFB6C1</Color>
    <Color x:Key="TokenRedDark">#8B0000</Color>

    <Color x:Key="TokenEmergency">#7B68EE</Color>
    <Color x:Key="TokenEmergencyLight">#9F8FDF</Color>
    <Color x:Key="TokenEmergencyDark">#4B3FA0</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusGiven">#00C853</Color>
    <Color x:Key="StatusSanctum">#CC5500</Color>
    <Color x:Key="StatusVip">#6A1B9A</Color>
    <Color x:Key="StatusPending">#FFB300</Color>

    <!-- Card Background -->
    <Color x:Key="CardBackground">#2A2D3A</Color>
    <Color x:Key="CardBackgroundLight">#3A3D4A</Color>

    <!-- Brush versions for token colors -->
    <SolidColorBrush x:Key="TokenYellowBrush"
                     Color="{StaticResource TokenYellow}"/>
    <SolidColorBrush x:Key="TokenRedBrush"
                     Color="{StaticResource TokenRed}"/>
    <SolidColorBrush x:Key="TokenEmergencyBrush"
                     Color="{StaticResource TokenEmergency}"/>
    <SolidColorBrush x:Key="StatusGivenBrush"
                     Color="{StaticResource StatusGiven}"/>
    <SolidColorBrush x:Key="StatusSanctumBrush"
                     Color="{StaticResource StatusSanctum}"/>
    <SolidColorBrush x:Key="StatusVipBrush"
                     Color="{StaticResource StatusVip}"/>

    <Color x:Key="PrimaryTextColor">#1E293B</Color>
    <Color x:Key="SecondaryTextColor">#64748B</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="ErrorColor">#BA1A1A</Color>

</ResourceDictionary>