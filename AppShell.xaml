<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TokenApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TokenApp"
    xmlns:views="clr-namespace:TokenApp.Views"
    Title="TokenApp"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="MainPage"
        Shell.NavBarIsVisible="False"/>

    <ShellContent
        Title="History/Queue"
        ContentTemplate="{DataTemplate views:TokenHistoryPage}"
        Route="TokenHistory"/>

</Shell>
